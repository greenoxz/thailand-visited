{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "map.html", "use": "@vercel/static" },
    { "src": "bill-split.html", "use": "@vercel/static" },
    { "src": "privacy.html", "use": "@vercel/static" },
    { "src": "sitemap.html", "use": "@vercel/static" },
    { "src": "main.js", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "favicon.png", "use": "@vercel/static" },
    { "src": "termtem-logo.png", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "ads.txt", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" },
    { "src": "og-image.png", "use": "@vercel/static" },
    { "src": "qrcode.png", "use": "@vercel/static" },
    { "src": "site.webmanifest", "use": "@vercel/static" },
    { "src": "data/**", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/maps", "dest": "map.html" },
    { "src": "/maps/", "dest": "map.html" },
    { "src": "/map", "dest": "map.html" },
    { "src": "/map/", "dest": "map.html" },
    { "src": "/bill-split", "dest": "bill-split.html" },
    { "src": "/bill-split/", "dest": "bill-split.html" },
    { "src": "/sitemap", "dest": "sitemap.html" },
    { "src": "/sitemap/", "dest": "sitemap.html" },
    { "src": "/privacy", "dest": "privacy.html" },
    { "src": "/privacy/", "dest": "privacy.html" },
    { "src": "/(.*)", "dest": "$1" }
  ]
}