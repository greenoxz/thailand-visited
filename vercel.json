{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "**", "use": "@vercel/static" }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/map", "destination": "/maps", "permanent": true }
  ],
  "rewrites": [
    { "source": "/maps", "destination": "/map.html" }
  ]
}